@page
@model asp_presentacion.Pages.Ventanas.AdminModel
@{
    ViewData["Title"] = "Panel Admin - BiblioTech";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Admin.css" />
}

<div class="admin-container">
    <div class="admin-card">
        <div class="admin-header">
            <div class="header-left">
                <a href="/Index" class="btn-back"><i class="bi bi-arrow-left"></i> Inicio</a>
                <h1 class="title"><i class="bi bi-shield-lock-fill"></i> Panel Administrativo</h1>
            </div>
            <div>
                <form method="post" asp-page-handler="Logout" style="display:inline">
                    <button type="submit" class="btn-danger" style="padding:0.5rem 1rem"><i class="bi bi-box-arrow-right"></i> Cerrar Sesion</button>
                </form>
            </div>
        </div>

        <div class="stats-grid-admin">
            <div class="stat-card-admin">
                <div class="stat-number-admin">@Model.Libros.Count</div>
                <div class="stat-label-admin">Libros</div>
            </div>
            <div class="stat-card-admin">
                <div class="stat-number-admin">@Model.Autores.Count</div>
                <div class="stat-label-admin">Autores</div>
            </div>
            <div class="stat-card-admin">
                <div class="stat-number-admin">@Model.Prestamos.Count(p => p.Fecha_Entrega_Real == null)</div>
                <div class="stat-label-admin">Prestamos Activos</div>
            </div>
            <div class="stat-card-admin">
                <div class="stat-number-admin">@Model.Sanciones.Count(s => !s.Fecha_Fin.HasValue || s.Fecha_Fin.Value > DateTime.Now)</div>
                <div class="stat-label-admin">Sanciones Activas</div>
            </div>
        </div>

        <div class="tabs-container">
            <button class="tab-btn active" data-tab="libros"><i class="bi bi-book"></i> Libros</button>
            <button class="tab-btn" data-tab="autores"><i class="bi bi-pencil"></i> Autores</button>
            <button class="tab-btn" data-tab="editoriales"><i class="bi bi-building"></i> Editoriales</button>
            <button class="tab-btn" data-tab="temas"><i class="bi bi-tags"></i> Temas</button>
            <button class="tab-btn" data-tab="existencias"><i class="bi bi-files"></i> Existencias</button>
            <button class="tab-btn" data-tab="prestamos"><i class="bi bi-journal-arrow-up"></i> Prestamos</button>
            <button class="tab-btn" data-tab="sanciones"><i class="bi bi-exclamation-triangle"></i> Sanciones</button>
            <button class="tab-btn" data-tab="usuarios"><i class="bi bi-people"></i> Usuarios</button>
        </div>

        <!-- TAB LIBROS -->
        <div id="tabLibros" class="tab-content active">
            <div class="form-grid">
                <form method="post" asp-page-handler="AddLibro">
                    <div class="form-group">
                        <label>Nuevo Libro</label>
                        <input asp-for="NewLibro.Titulo" class="form-control" placeholder="Titulo" required />
                        <input asp-for="NewLibro.Isbn" class="form-control" placeholder="ISBN" />
                        <select asp-for="NewLibro.Editorial" class="form-control" required>
                            <option value="">Seleccione Editorial</option>
                            @foreach (var ed in Model.Editoriales)
                            {
                                <option value="@ed.Id">@ed.Nombre_Editorial</option>
                            }
                        </select>
                        <input asp-for="NewLibro.Edicion" class="form-control" placeholder="Edicion" />
                        <input asp-for="NewLibro.Fecha_Lanzamiento" class="form-control" type="date" />
                        <select asp-for="NewLibro.Pais" class="form-control">
                            <option value="">Seleccione Pais</option>
                            @foreach (var p in Model.Paises)
                            {
                                <option value="@p.Id">@p.Nombre_Pais</option>
                            }
                        </select>
                        <select asp-for="NewLibro.Tipo" class="form-control">
                            <option value="">Seleccione Tipo</option>
                            @foreach (var t in Model.TiposLibro)
                            {
                                <option value="@t.Id">@t.Nombre_Tipo</option>
                            }
                        </select>
                        <button type="submit" class="btn-primary" style="margin-top:0.5rem"><i class="bi bi-plus-lg"></i> Agregar Libro</button>
                    </div>
                </form>
                <div>
                    <div class="form-group">
                        <label>Asignar Autor a Libro</label>
                        <form method="post" asp-page-handler="AsignarAutorLibro" style="display:flex; flex-direction:column; gap:0.5rem">
                            <select name="libroId" class="form-control" required>
                                <option value="">Seleccione Libro</option>
                                @foreach (var l in Model.Libros)
                                {
                                    <option value="@l.Id">@l.Titulo</option>
                                }
                            </select>
                            <select name="autorId" class="form-control" required>
                                <option value="">Seleccione Autor</option>
                                @foreach (var a in Model.Autores)
                                {
                                    <option value="@a.Id">@a.Nombre</option>
                                }
                            </select>
                            <button type="submit" class="btn-success"><i class="bi bi-link"></i> Asignar Autor</button>
                        </form>
                    </div>
                    <div class="form-group">
                        <label>Asignar Tema a Libro</label>
                        <form method="post" asp-page-handler="AsignarTemaLibro" style="display:flex; flex-direction:column; gap:0.5rem">
                            <select name="libroId" class="form-control" required>
                                <option value="">Seleccione Libro</option>
                                @foreach (var l in Model.Libros)
                                {
                                    <option value="@l.Id">@l.Titulo</option>
                                }
                            </select>
                            <select name="temaId" class="form-control" required>
                                <option value="">Seleccione Tema</option>
                                @foreach (var t in Model.Temas)
                                {
                                    <option value="@t.Id">@t.Nombre_Tema</option>
                                }
                            </select>
                            <button type="submit" class="btn-success"><i class="bi bi-tag"></i> Asignar Tema</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Titulo</th>
                            <th>ISBN</th>
                            <th>Editorial</th>
                            <th>Autores</th>
                            <th>Temas</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Libros)
                        {
                            var autoresLibro = Model.LibrosAutores.Where(la => la.Libro == l.Id).Select(la => Model.Autores.FirstOrDefault(a => a.Id == la.Autor)?.Nombre).Where(n => n != null);
                            var temasLibro = Model.LibrosTemas.Where(lt => lt.Libro == l.Id).Select(lt => Model.Temas.FirstOrDefault(t => t.Id == lt.Tema)?.Nombre_Tema).Where(n => n != null);
                            <tr>
                                <td>@l.Id</td>
                                <td>@l.Titulo</td>
                                <td>@l.Isbn</td>
                                <td>@Model.Editoriales.FirstOrDefault(e => e.Id == l.Editorial)?.Nombre_Editorial</td>
                                <td>@string.Join(", ", autoresLibro)</td>
                                <td>@string.Join(", ", temasLibro)</td>
                                <td class="action-buttons">
                                    <button class="btn-icon btn-edit" onclick="abrirModalEditarLibro(@l.Id, '@(l.Titulo?.Replace("'", "\\'") ?? "")', '@(l.Isbn?.Replace("'", "\\'") ?? "")', '@(l.Edicion?.Replace("'", "\\'") ?? "")', '@(l.Fecha_Lanzamiento?.ToString("yyyy-MM-dd") ?? "")')"><i class="bi bi-pencil"></i></button>
                                    <form method="post" asp-page-handler="DeleteLibro" style="display:inline">
                                        <input type="hidden" name="id" value="@l.Id" />
                                        <button type="submit" class="btn-icon btn-delete" onclick="return confirm('Eliminar libro?')"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB AUTORES -->
        <div id="tabAutores" class="tab-content">
            <div class="form-grid">
                <form method="post" asp-page-handler="AddAutor">
                    <div class="form-group">
                        <label>Nuevo Autor</label>
                        <input asp-for="NewAutor.Nombre" class="form-control" placeholder="Nombre" required />
                        <input asp-for="NewAutor.Nacionalidad" class="form-control" placeholder="Nacionalidad" />
                        <button type="submit" class="btn-primary" style="margin-top:0.5rem"><i class="bi bi-plus-lg"></i> Agregar Autor</button>
                    </div>
                </form>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Nacionalidad</th>
                            <th>Libros</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Autores)
                        {
                            var librosAutor = Model.LibrosAutores.Where(la => la.Autor == a.Id).Select(la => Model.Libros.FirstOrDefault(l => l.Id == la.Libro)?.Titulo).Where(n => n != null);
                            <tr>
                                <td>@a.Id</td>
                                <td>@a.Nombre</td>
                                <td>@a.Nacionalidad</td>
                                <td>@string.Join(", ", librosAutor)</td>
                                <td class="action-buttons">
                                    <button class="btn-icon btn-edit" onclick="abrirModalEditarAutor(@a.Id, '@(a.Nombre?.Replace("'", "\\'") ?? "")', '@(a.Nacionalidad?.Replace("'", "\\'") ?? "")')"><i class="bi bi-pencil"></i></button>
                                    <form method="post" asp-page-handler="DeleteAutor" style="display:inline">
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <button type="submit" class="btn-icon btn-delete" onclick="return confirm('Eliminar autor?')"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB EDITORIALES -->
        <div id="tabEditoriales" class="tab-content">
            <div class="form-grid">
                <form method="post" asp-page-handler="AddEditorial">
                    <div class="form-group">
                        <label>Nueva Editorial</label>
                        <input asp-for="NewEditorial.Nombre_Editorial" class="form-control" placeholder="Nombre" required />
                        <input asp-for="NewEditorial.Sitio_Web" class="form-control" placeholder="Sitio Web" />
                        <button type="submit" class="btn-primary" style="margin-top:0.5rem"><i class="bi bi-plus-lg"></i> Agregar Editorial</button>
                    </div>
                </form>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Sitio Web</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Editoriales)
                        {
                            <tr>
                                <td>@e.Id</td>
                                <td>@e.Nombre_Editorial</td>
                                <td>@e.Sitio_Web</td>
                                <td class="action-buttons">
                                    <button class="btn-icon btn-edit" onclick="abrirModalEditarEditorial(@e.Id, '@(e.Nombre_Editorial?.Replace("'", "\\'") ?? "")', '@(e.Sitio_Web?.Replace("'", "\\'") ?? "")')"><i class="bi bi-pencil"></i></button>
                                    <form method="post" asp-page-handler="DeleteEditorial" style="display:inline">
                                        <input type="hidden" name="id" value="@e.Id" />
                                        <button type="submit" class="btn-icon btn-delete" onclick="return confirm('Eliminar editorial?')"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB TEMAS -->
        <div id="tabTemas" class="tab-content">
            <div class="form-grid">
                <form method="post" asp-page-handler="AddTema">
                    <div class="form-group">
                        <label>Nuevo Tema</label>
                        <input asp-for="NewTema.Nombre_Tema" class="form-control" placeholder="Nombre" required />
                        <input asp-for="NewTema.Area_Conocimiento" class="form-control" placeholder="Area de Conocimiento" />
                        <button type="submit" class="btn-primary" style="margin-top:0.5rem"><i class="bi bi-plus-lg"></i> Agregar Tema</button>
                    </div>
                </form>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Area de Conocimiento</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Temas)
                        {
                            <tr>
                                <td>@t.Id</td>
                                <td>@t.Nombre_Tema</td>
                                <td>@t.Area_Conocimiento</td>
                                <td class="action-buttons">
                                    <button class="btn-icon btn-edit" onclick="abrirModalEditarTema(@t.Id, '@(t.Nombre_Tema?.Replace("'", "\\'") ?? "")', '@(t.Area_Conocimiento?.Replace("'", "\\'") ?? "")')"><i class="bi bi-pencil"></i></button>
                                    <form method="post" asp-page-handler="DeleteTema" style="display:inline">
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button type="submit" class="btn-icon btn-delete" onclick="return confirm('Eliminar tema?')"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB EXISTENCIAS -->
        <div id="tabExistencias" class="tab-content">
            <div class="form-grid">
                <form method="post" asp-page-handler="AddExistencia">
                    <div class="form-group">
                        <label>Nueva Existencia</label>
                        <select asp-for="NewExistencia.Libro" class="form-control" required>
                            <option value="">Seleccione Libro</option>
                            @foreach (var l in Model.Libros)
                            {
                                <option value="@l.Id">@l.Titulo</option>
                            }
                        </select>
                        <input asp-for="NewExistencia.Ejemplares" class="form-control" placeholder="Numero de Ejemplares" type="number" required />
                        <button type="submit" class="btn-primary" style="margin-top:0.5rem"><i class="bi bi-plus-lg"></i> Agregar Existencia</button>
                    </div>
                </form>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Libro</th>
                            <th>Ejemplares</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ex in Model.Existencias)
                        {
                            <tr>
                                <td>@ex.Id</td>
                                <td>@Model.Libros.FirstOrDefault(l => l.Id == ex.Libro)?.Titulo</td>
                                <td>@ex.Ejemplares</td>
                                <td class="action-buttons">
                                    <button class="btn-icon btn-edit" onclick="abrirModalEditarExistencia(@ex.Id, @ex.Ejemplares)"><i class="bi bi-pencil"></i></button>
                                    <form method="post" asp-page-handler="DeleteExistencia" style="display:inline">
                                        <input type="hidden" name="id" value="@ex.Id" />
                                        <button type="submit" class="btn-icon btn-delete" onclick="return confirm('Eliminar existencia?')"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB PRESTAMOS -->
        <div id="tabPrestamos" class="tab-content">
            <div class="form-grid">
                <form method="post" asp-page-handler="AddPrestamo">
                    <div class="form-group">
                        <label>Registrar Prestamo</label>
                        <select asp-for="NewPrestamo.Usuario" class="form-control" required>
                            <option value="">Seleccione Usuario</option>
                            @foreach (var u in Model.Usuarios)
                            {
                                <option value="@u.Id">@u.Nombre - @u.Documento</option>
                            }
                        </select>
                        <select asp-for="NewPrestamo.Existencia" class="form-control" required>
                            <option value="">Seleccione Ejemplar</option>
                            @foreach (var ex in Model.Existencias.Where(e => e.Ejemplares > 0))
                            {
                                var libro = Model.Libros.FirstOrDefault(l => l.Id == ex.Libro);
                                <option value="@ex.Id">@libro?.Titulo - @ex.Ejemplares disponibles</option>
                            }
                        </select>
                        <select asp-for="NewPrestamo.Tipo_Prestamo" class="form-control">
                            <option value="2">Prestamo a domicilio</option>
                            <option value="1">Consulta en sala</option>
                            <option value="3">Prestamo interbibliotecario</option>
                            <option value="4">Reserva especial</option>
                            <option value="5">Consulta restringida</option>
                        </select>
                        <button type="submit" class="btn-success" style="margin-top:0.5rem"><i class="bi bi-journal-plus"></i> Registrar Prestamo</button>
                    </div>
                </form>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Usuario</th>
                            <th>Libro</th>
                            <th>Fecha Prestamo</th>
                            <th>Fecha Devolucion</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Prestamos)
                        {
                            var existencia = Model.Existencias.FirstOrDefault(e => e.Id == p.Existencia);
                            var libro = existencia != null ? Model.Libros.FirstOrDefault(l => l.Id == existencia.Libro) : null;
                            var usuario = Model.Usuarios.FirstOrDefault(u => u.Id == p.Usuario);
                            var estado = p.Fecha_Entrega_Real.HasValue ? "Devuelto" : (p.Fecha_Devolucion < DateTime.Now ? "Vencido" : "Activo");
                            <tr>
                                <td>@p.Id</td>
                                <td>@usuario?.Nombre (@usuario?.Documento)</td>
                                <td>@libro?.Titulo</td>
                                <td>@p.Fecha_Prestamo.ToString("dd/MM/yyyy")</td>
                                <td>@p.Fecha_Devolucion?.ToString("dd/MM/yyyy") ?? "Pendiente"</td>
                                <td><span class="estado-badge estado-@estado.ToLower()">@estado</span></td>
                                <td class="action-buttons">
                                    @if (!p.Fecha_Entrega_Real.HasValue)
                                    {
                                        <button class="btn-icon btn-edit" onclick="registrarDevolucion(@p.Id)"><i class="bi bi-arrow-return-left"></i> Devolver</button>
                                    }
                                    <form method="post" asp-page-handler="DeletePrestamo" style="display:inline">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button type="submit" class="btn-icon btn-delete" onclick="return confirm('Eliminar prestamo?')"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB SANCIONES -->
        <div id="tabSanciones" class="tab-content">
            <div class="form-grid">
                <form method="post" asp-page-handler="AddSancion">
                    <div class="form-group">
                        <label>Nueva Sancion</label>
                        <select asp-for="NewSancion.Usuario" class="form-control" required>
                            <option value="">Seleccione Usuario</option>
                            @foreach (var u in Model.Usuarios)
                            {
                                <option value="@u.Id">@u.Nombre - @u.Documento</option>
                            }
                        </select>
                        <input asp-for="NewSancion.Descripcion" class="form-control" placeholder="Descripcion" required />
                        <input asp-for="NewSancion.Fecha_Inicio" class="form-control" type="date" />
                        <input asp-for="NewSancion.Fecha_Fin" class="form-control" type="date" placeholder="Fecha Fin (opcional)" />
                        <button type="submit" class="btn-warning" style="margin-top:0.5rem"><i class="bi bi-exclamation-triangle"></i> Aplicar Sancion</button>
                    </div>
                </form>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Usuario</th>
                            <th>Descripcion</th>
                            <th>Inicio</th>
                            <th>Fin</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Sanciones)
                        {
                            var usuario = Model.Usuarios.FirstOrDefault(u => u.Id == s.Usuario);
                            var activa = !s.Fecha_Fin.HasValue || s.Fecha_Fin.Value > DateTime.Now;
                            <tr>
                                <td>@s.Id</td>
                                <td>@usuario?.Nombre (@usuario?.Documento)</td>
                                <td>@s.Descripcion</td>
                                <td>@s.Fecha_Inicio.ToString("dd/MM/yyyy")</td>
                                <td>@s.Fecha_Fin?.ToString("dd/MM/yyyy") ?? "Indefinida"</td>
                                <td><span class="estado-badge @(activa ? "estado-activo" : "estado-completado")">@(activa ? "Activa" : "Finalizada")</span></td>
                                <td class="action-buttons">
                                    <form method="post" asp-page-handler="DeleteSancion" style="display:inline">
                                        <input type="hidden" name="id" value="@s.Id" />
                                        <button type="submit" class="btn-icon btn-delete" onclick="return confirm('Eliminar sancion?')"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB USUARIOS -->
        <div id="tabUsuarios" class="tab-content">
            <div class="form-grid">
                <form method="post" asp-page-handler="AddUsuario">
                    <div class="form-group">
                        <label>Nuevo Usuario</label>
                        <input asp-for="NewUsuario.Nombre" class="form-control" placeholder="Nombre" required />
                        <input asp-for="NewUsuario.Documento" class="form-control" placeholder="Documento" required />
                        <input asp-for="NewUsuario.Correo" class="form-control" placeholder="Correo" type="email" required />
                        <input asp-for="NewUsuario.Contraseña" class="form-control" placeholder="Contraseña" type="password" required />
                        <input asp-for="NewUsuario.Direccion" class="form-control" placeholder="Direccion" />
                        <input asp-for="NewUsuario.Telefono" class="form-control" placeholder="Telefono" />
                        <input asp-for="NewUsuario.Fecha_Nacimiento" class="form-control" type="date" />
                        <select asp-for="NewUsuario.Rol" class="form-control" required>
                            <option value="usuario">Usuario</option>
                            <option value="admin">Administrador</option>
                        </select>
                        <button type="submit" class="btn-primary" style="margin-top:0.5rem"><i class="bi bi-plus-lg"></i> Agregar Usuario</button>
                    </div>
                </form>
            </div>
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Documento</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.UsuariosTodos)
                        {
                            <tr>
                                <td>@u.Id</td>
                                <td>@u.Nombre</td>
                                <td>@u.Documento</td>
                                <td>@u.Correo</td>
                                <td><span class="estado-badge @(u.Rol == "admin" ? "estado-activo" : "estado-completado")">@u.Rol</span></td>
                                <td class="action-buttons">
                                    @if (u.Rol != "admin")
                                    {
                                        <form method="post" asp-page-handler="DeleteUsuario" style="display:inline">
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="btn-icon btn-delete" onclick="return confirm('Eliminar usuario?')"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL PARA EDITAR -->
<div id="modalEditar" class="modal-modern" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="modalTitulo">Editar</h3>
            <button class="modal-close" onclick="cerrarModal()">&times;</button>
        </div>
        <div class="modal-body" id="modalBody"></div>
    </div>
</div>

<!-- TOAST -->
<div id="toast" class="toast"></div>

@section Scripts {
    <script src="~/js/admin-app.js"></script>
}